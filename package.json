{
  "name": "eira-resultados",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma de entrega digital segura y trazable de resultados para EIRA Movimiento Rosa A.C.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "backend",
    "frontend",
    "infrastructure"
  ],
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "infra:validate": "npm run validate -w @eira/infrastructure",
    "infra:checkov": "npm run checkov -w @eira/infrastructure",
    "dynamodb:up": "npm run dynamodb:up -w @eira/infrastructure",
    "dynamodb:down": "npm run dynamodb:down -w @eira/infrastructure",
    "test:integration": "npm run test:integration -w @eira/infrastructure && npm run test:integration -w @eira/backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
